# Copy these lines into your real .env file (which is ignored by git) and fill them in.
# Find both in Supabase: Project Settings -> API.

# The project URL, like https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "publishable" key. It is meant to be public: the database rules decide what it can do.
# NEVER put the "service_role" / "secret" key here. That one bypasses every rule.
VITE_SUPABASE_ANON_KEY=
